# Copy to terraform.tfvars on the work box and fill real values. terraform.tfvars is gitignored.

# IMPORTANT — two projects are involved:
#   - ut-dnr-ugs-maps-prod        holds the buckets + Cloud Run + the LB → project_id below.
#   - ut-dnr-ugs-backend-tools    holds Artifact Registry + Cloud Build + the runtime SA identity.
# The runtime SA lives in backend-tools but is granted IAM on the maps-prod bucket (cross-project) —
# that's expected. Do NOT set project_id from the SA's domain; it's the BUCKET's project.
project_id = "ut-dnr-ugs-maps-prod"
region     = "us-central1"

# Least-privilege deploy: impersonate a dedicated SA that holds the apply-time admin roles (bootstrap
# once — see infra/README.md "Deploy SA"). The operator only needs tokenCreator on it. Leave empty to
# apply directly as your own ADC identity instead.
deploy_service_account = "warehouse-deploy@ut-dnr-ugs-maps-prod.iam.gserviceaccount.com"

# Existing prod bucket — referenced read-only. Lives in project_id above.
public_bucket = "ut-dnr-ugs-maps-prod-public"

# New private review bucket (created here, in project_id above).
review_bucket = "ut-dnr-ugs-maps-prod-review"

# Serving image — the warehouse image, in the backend-tools Artifact Registry (cross-project pull).
# The maps-prod Cloud Run service agent needs artifactregistry.reader on this repo — verify/add that
# grant, or the serving service can't pull the image.
serving_image = "us-central1-docker.pkg.dev/ut-dnr-ugs-backend-tools/ugs-warehouse/ugs-warehouse:latest"

# SA the ugs-warehouse-ingest-review job runs as (needs write on the review bucket). In backend-tools;
# the review-bucket IAM binding grants it cross-project — leave as-is.
ingest_service_account = "warehouse-run@ut-dnr-ugs-backend-tools.iam.gserviceaccount.com"

# Cloud Build SA that publishes the internal viewer into the review bucket (deploy-viewer-review step).
# Gets objectAdmin on the review bucket. Find it from the build trigger; empty = viewer publish no-ops
# (the step is allowFailure until this is set).
build_service_account = "REPLACE-cloudbuild-sa@REPLACE-build-project.iam.gserviceaccount.com"

# IAP — native Cloud Run IAP (no LB / custom domain / DNS / cert). The review group whose members may
# pass IAP (the reviewer set — manage membership in Workspace, not here). The service is reached on its
# *.run.app URL (see `tofu output serving_url`). One-time console setting, not tofu: the project's
# OAuth consent screen needs a support email set once for IAP to serve.
iap_group = "nrugsall@utah.gov"

# --- Cloud Build triggers (cloudbuild-triggers.tf) -------------------------------------------------
# Both must be set for the triggers to be managed here; leave empty and they stay console-managed.
# The repository comes from the GitHub App install, not tofu:
#   gcloud builds connections list --region=us-central1 --project=ut-dnr-ugs-backend-tools
# build_repository        = "projects/ut-dnr-ugs-backend-tools/locations/us-central1/connections/ugs-warehouse-github/repositories/ugs-warehouse"
# trigger_service_account = "projects/ut-dnr-ugs-backend-tools/serviceAccounts/534590904912-compute@developer.gserviceaccount.com"
# The PR-preview triggers run as the least-trusted identity, not the Compute SA above:
# preview_trigger_service_account = "projects/ut-dnr-ugs-backend-tools/serviceAccounts/ugs-warehouse-preview-build@ut-dnr-ugs-backend-tools.iam.gserviceaccount.com"

# Monthly offline-basemap rebuild (basemap-refresh.tf). The SA Cloud Scheduler calls the trigger as,
# set up by hand first (the file's header); empty: the trigger exists but only runs by hand.
# basemap_scheduler_service_account = "ugs-basemap-scheduler@ut-dnr-ugs-backend-tools.iam.gserviceaccount.com"
# basemap_schedule = "0 6 1 * *"
