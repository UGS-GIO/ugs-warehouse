# tippecanoe comes prebuilt from the ugs-tippecanoe base image (compiled once via
# cloudbuild.tippecanoe.yaml) — no per-build compile. Override with --build-arg TIPPECANOE_IMAGE=.
# Cloud Run Job runtime: runs the harvest/ingest CLI task.
ARG TIPPECANOE_IMAGE=us-central1-docker.pkg.dev/ut-dnr-ugs-backend-tools/ugs-warehouse/ugs-tippecanoe:latest
FROM ${TIPPECANOE_IMAGE} AS tippecanoe

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Runtime deps for tippecanoe + GDAL CLI + poppler.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl libsqlite3-0 zlib1g \
      gdal-bin poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# go-pmtiles CLI — converts the GDAL-built raster MBTiles into PMTiles (pubs/geolmap_mosaics.py).
ARG PMTILES_VERSION=1.22.3
RUN arch="$(dpkg --print-architecture)"; case "$arch" in amd64) a=x86_64;; arm64) a=arm64;; *) a="$arch";; esac; \
    curl -fsSL "https://github.com/protomaps/go-pmtiles/releases/download/v${PMTILES_VERSION}/go-pmtiles_${PMTILES_VERSION}_Linux_${a}.tar.gz" \
      | tar -xz -C /usr/local/bin pmtiles \
    && chmod +x /usr/local/bin/pmtiles && pmtiles version

# Bring tippecanoe over from the prebuilt base image.
COPY --from=tippecanoe /usr/local/bin/tippecanoe /usr/local/bin/tile-join /usr/local/bin/

WORKDIR /app
# Deps layer — cached until pyproject.toml changes (NOT on every code edit). Install the heavy
# [pubs] deps against an empty package skeleton, then drop it; real source comes next.
COPY pyproject.toml ./
RUN mkdir -p src/ugs_warehouse && touch src/ugs_warehouse/__init__.py \
    && pip install --upgrade pip && pip install .[pubs] \
    && rm -rf src

# Pre-warm the fastembed model into the image so the embed job never pulls from HuggingFace at
# runtime (an unauthenticated HF download rate-limited + timed out the job once). Cached in its own
# layer, keyed to the deps layer above. embed.py reads the same dir via FASTEMBED_CACHE.
ENV FASTEMBED_CACHE=/opt/fastembed
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5', cache_dir='/opt/fastembed')"

# App layer — only this rebuilds on a source change (deps already satisfied above).
COPY src ./src
COPY service ./service
COPY scripts ./scripts
RUN chmod +x scripts/*.sh && pip install --no-deps --force-reinstall .

# Cloud Run Job does not expose a port; its ENTRYPOINT/CMD runs the CLI.
# Default to running the harvester over the manifest.
CMD ["python", "-m", "ugs_warehouse.pubs.harvest", "--all"]
