# ugs-topics-thumbs job image — all-Python. Reads the serving-topics STAC, GCS IO, content-hash skip,
# then renders each topic's styled PMTiles → WebP via headless Chromium driven by Playwright (no Node).
# MapLibre needs WebGL, so the render runs in a real browser (software GL / SwiftShader in Cloud Run);
# the maplibre-gl + pmtiles browser libs are vendored in the package (vector/render_assets/).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

WORKDIR /app

# Deps layer, same shape as the main Dockerfile: the package's deps + the thumbs extra (playwright,
# requests) installed against an empty skeleton, so it and the layers below are cached until
# pyproject.toml changes, not rebuilt on every code edit. No GDAL/tippecanoe weight in this job.
COPY pyproject.toml ./
RUN mkdir -p src/ugs_warehouse && touch src/ugs_warehouse/__init__.py \
    && pip install --upgrade pip && pip install ".[thumbs]" \
    && rm -rf src

# The job refreshes the catalog after stamping, which rebuilds the raster collections' item mirrors
# with DuckDB spatial (core/item_mirror.py). Bake the extension in, as the main image does, so that
# never depends on a download from the extension servers at 04:00.
RUN python -c "import duckdb; c = duckdb.connect(); c.execute('INSTALL spatial')"

# Chromium + its OS deps for Playwright (installs into PLAYWRIGHT_BROWSERS_PATH).
RUN playwright install --with-deps chromium

# App layer — only this rebuilds on a source change.
COPY src ./src
RUN pip install --no-deps --force-reinstall .

ENTRYPOINT ["python", "-m", "ugs_warehouse.vector.thumbs"]
CMD ["--all"]
