{
  "hosting": {
    "site": "data-geology-utah-gov",
    "public": "viewer/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/catalog{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/map{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/discover{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/arch{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/guide{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/developers{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/preview{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/offline{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/review{,/**}",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
