# Cloud Run SERVICES monitoring (review-serving / review-api) — they run in a different project
# than the jobs. Runtime SA needs roles/run.viewer + roles/logging.viewer in this project.
SERVICES_PROJECT=ut-dnr-ugs-maps-prod
