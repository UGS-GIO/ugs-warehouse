DEBUG=True
DEV_IAP_EMAIL=you@utah.gov
JOBS_DRY_RUN=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# --- prod (Cloud Run behind IAP) — set via cloudbuild deploy, not here ---
# DEBUG=False
# JOBS_DRY_RUN=False
# ALLOWED_HOSTS=.run.app,warehouse-admin.geology.utah.gov
