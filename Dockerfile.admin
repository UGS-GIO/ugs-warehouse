# Cloud Run service: Django + HTMX ops console behind IAP. Reads the STAC catalog and triggers the
# warehouse's Cloud Run jobs — stores nothing (SQLite is ephemeral, Django tables only).
# Build context is the repo root: `docker build -f Dockerfile.admin .`
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# The warehouse package (BASE deps only — no GDAL/raster `pubs` extra). The Publications Registry
# reuses its real pub-metadata + GCS reads (source / gcs / sink_stac.series_code) instead of
# reimplementing them, so the harvest status can't drift from the harvester. Vendored pub CSVs ship
# as package-data, so this needs no DB. Listing the COG bucket needs storage.objectViewer on the SA.
COPY --from=ghcr.io/astral-sh/uv:0.12.12@sha256:73d2665b478d8fa2de1cf105c6841f8e9cb6b09e568fc7700440c09f8fcd7ac4 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./warehouse/
RUN uv export --frozen --no-emit-project --project warehouse -q -o /tmp/requirements.txt \
    && pip install -r /tmp/requirements.txt && rm /tmp/requirements.txt
COPY src ./warehouse/src/
RUN pip install --no-deps ./warehouse

# Admin app deps.
COPY admin/requirements.txt ./
RUN pip install -r requirements.txt

COPY admin/ ./

# Bake the static manifest (whitenoise). SECRET_KEY is a throwaway just for the build command.
RUN SECRET_KEY=build DEBUG=False python manage.py collectstatic --noinput

EXPOSE 8080
# Ephemeral migrate (Django's own tables) then serve. $PORT is set by Cloud Run.
CMD exec sh -c "python manage.py migrate --noinput && \
  exec gunicorn config.wsgi:application --bind 0.0.0.0:\${PORT:-8080} --workers 2 --timeout 120"
