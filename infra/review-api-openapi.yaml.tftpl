## API Gateway spec for the review API — the "front desk".
## Validates the caller's Firebase/Entra ID token at the edge, then forwards to the private Cloud Run
## service (review-api), invoking it as the gateway's service account (jwt_audience → run.invoker), so
## Cloud Run's invoker check + Domain-Restricted-Sharing are both satisfied. Templated by tofu:
##   backend_url = the review-api Cloud Run URL, project_id = the Firebase/GCP project.
swagger: "2.0"
info:
  title: ugs-warehouse-review-api-gateway
  version: "1.0.0"
schemes:
  - https
produces:
  - application/json
# Validate Firebase/Identity-Platform ID tokens: issuer + audience are the project.
securityDefinitions:
  firebase:
    authorizationUrl: ""
    flow: implicit
    type: oauth2
    x-google-issuer: "https://securetoken.google.com/${project_id}"
    x-google-jwks_uri: "https://www.googleapis.com/service_accounts/v1/metadata/x509/securetoken@system.gserviceaccount.com"
    x-google-audiences: "${project_id}"
paths:
  # Greedy proxy: everything under /api/* is forwarded to the Cloud Run backend with the same path,
  # invoked as the gateway SA (jwt_audience = backend URL → passes Cloud Run's invoker IAM check).
  "/api/{proxy=**}":
    get:
      operationId: apiGet
      security: [{ firebase: [] }]
      parameters: [{ name: proxy, in: path, required: true, type: string }]
      x-google-backend: { address: "${backend_url}", path_translation: APPEND_PATH_TO_ADDRESS, jwt_audience: "${backend_url}" }
      responses: { "200": { description: OK } }
    post:
      operationId: apiPost
      security: [{ firebase: [] }]
      parameters: [{ name: proxy, in: path, required: true, type: string }]
      x-google-backend: { address: "${backend_url}", path_translation: APPEND_PATH_TO_ADDRESS, jwt_audience: "${backend_url}" }
      responses: { "200": { description: OK } }
    patch:
      operationId: apiPatch
      security: [{ firebase: [] }]
      parameters: [{ name: proxy, in: path, required: true, type: string }]
      x-google-backend: { address: "${backend_url}", path_translation: APPEND_PATH_TO_ADDRESS, jwt_audience: "${backend_url}" }
      responses: { "200": { description: OK } }
    put:
      operationId: apiPut
      security: [{ firebase: [] }]
      parameters: [{ name: proxy, in: path, required: true, type: string }]
      x-google-backend: { address: "${backend_url}", path_translation: APPEND_PATH_TO_ADDRESS, jwt_audience: "${backend_url}" }
      responses: { "200": { description: OK } }
    delete:
      operationId: apiDelete
      security: [{ firebase: [] }]
      parameters: [{ name: proxy, in: path, required: true, type: string }]
      x-google-backend: { address: "${backend_url}", path_translation: APPEND_PATH_TO_ADDRESS, jwt_audience: "${backend_url}" }
      responses: { "200": { description: OK } }
    # CORS preflight — no auth; forwarded to the backend, whose CORS middleware (REVIEW_CORS_ORIGINS)
    # returns the headers for the viewer origins.
    options:
      operationId: apiOptions
      parameters: [{ name: proxy, in: path, required: true, type: string }]
      x-google-backend: { address: "${backend_url}", path_translation: APPEND_PATH_TO_ADDRESS }
      responses: { "204": { description: CORS preflight } }
