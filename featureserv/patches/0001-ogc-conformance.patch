 func (cat *catalogDB) loadTables() {
+	prior := cat.tableMap
 	cat.tableMap = cat.readTables(cat.dbconn)
+	// readTables returns zero-value extents, and computing one is a full ST_Envelope_Agg over the
+	// (possibly remote) data -- so carry forward what we already measured. Safe because the
+	// collection set is fixed for the life of the process: gen_db swaps the database file before
+	// the server binds its port, never underneath it.
+	for id, tbl := range cat.tableMap {
+		if old, ok := prior[id]; ok && old.Extent != (Extent{}) {
+			tbl.Extent = old.Extent
+		}
+	}
 	cat.tables = tablesSorted(cat.tableMap)
 }
 
